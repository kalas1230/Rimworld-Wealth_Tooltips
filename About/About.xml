<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <!-- Renamed from kalas.wealthreadout on 2026-09-02, while the mod was still unpublished.
       packageId is the mod's identity. ModsConfig.xml, other mods' loadAfter and dependency
       entries, and the Workshop item all key off it, so renaming it after release would orphan
       the mod in every existing modlist and turn an update into a different mod. Before first
       publish it costs nothing. That window is now closed: do not rename this again.
       (Note for editors: XML comments may not contain a double hyphen. Writing one here makes
       About.xml unparseable, and RimWorld then skips the mod entirely.) -->
  <packageId>kalas.wealthtooltips</packageId>
  <!-- "Wealth Readout" read as though the mod replaces or adds a readout panel. It does neither:
       it only rewrites tooltip text on vanilla's existing panel (HANDOVER rule 2). -->
  <name>Wealth Tooltips</name>
  <author>kalas</author>
  <!-- RimWorld renders this as a clickable link in the mod info panel. It is the only path back
       to source and issues for a player who installed from the zip or from a modpack, where the
       Workshop description is never seen. The same URL is repeated at the end of the Workshop
       description, because mod managers and modpack listings show the text and not this field. -->
  <url>https://github.com/kalas1230/Rimworld-Wealth_Tooltips</url>
  <modVersion>1.0.0</modVersion>
  <!-- 1.6 only, and LoadFolders.xml must say the same. supportedVersions is what actually gates
       loading; claiming a version this mod has never been run on is worse than not claiming it. -->
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <!-- The IN-GAME mod list text. Two sibling copies exist and drift apart if edited singly:
       docs\workshop-description.txt is the Workshop listing, and
       Release\upload\description-paste.txt is generated from that one. Change all three
       deliberately, or decide per edit which of them it belongs in. -->
  <description>Hover a row in the resource readout. See what it is worth.

The tooltip adds three things: the item or category's value in silver, its share of your colony's total wealth, and how much of it is stored versus sitting elsewhere; on the ground, in pawn inventories.</description>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
  </loadAfter>
</ModMetaData>
